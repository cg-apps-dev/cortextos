node_modules/
# Also ignore a bare `node_modules` symlink file (no trailing slash). Worktree-isolated
# branches symlink node_modules back to the main repo so tsc/vitest resolve deps;
# the trailing-slash rule above only matches a real directory, not the symlink file,
# so without this line `git add -A` in a worktree stages a machine-specific symlink.
node_modules
.claude/
!.claude/commands/
!.claude/commands/**
!.claude/orchestration-cortextos-node/
# Include template .claude dirs (needed for agent settings.json)
!templates/**/.claude/
!templates/**/.claude/**
dist/
ecosystem.config.js

# User-created org data (not part of the framework)
orgs/
# But community subdirectories ARE part of the framework
!community/
!community/**

# Secrets
.env
!.env.example

# Credential backups. These are ALREADY ignored via the orgs/ rule above, but that
# protection is incidental: orgs/ is ignored for unrelated reasons, so the day anyone
# un-ignores it to track agent configs, 30 files carrying live tokens become stageable
# and the person doing it will be thinking about configs, not secrets. A credential-
# specific rule costs one line and does not depend on orgs/ staying ignored forever.
*.env.bak
*.env.bak.*
*.env.bak-*
templates/*/.env
.cortextos-env

# Agent runtime data
orgs/*/agents/*/memory/
agents/*/local/
agents/*/telegram-images/
agents/*/memory/

# Runtime dashboard DB (lives outside the repo per CLAUDE.md; a local dashboard run creates .data/)
.data/

# macOS metadata
.DS_Store

# Test artifacts
test-results/
*.log
# Spurious directory created when ${APPDATA} env var unexpanded during npm link on Windows
${APPDATA}/

# Python bytecode (blanket - covers all __pycache__ dirs anywhere, incl. new ones from py_compile/test runs)
**/__pycache__/
*.pyc
*.pyo

# Knowledge base
knowledge-base/venv/
tests/playwright/dashboard-ui.spec.ts

# Local ops docs (personal, not for public repo)
docs/

# Internal ops/dev reports - never public.
*INSTALL_REPORT.md
*PHASE*-REPORT.md
docs/phase-reports/

# Leaked internal ops report - never re-track (upstream 086ba1d defense-in-depth)
WINDOWS_INSTALL_REPORT.md

# Internal developer/planning notes (not for public repo)
KNOWN-ISSUES.md
WINDOWS-IMPLEMENTATION-PLAN.md
WINDOWS-SUPPORT-INVESTIGATION.md
BRAINDUMP*.md
AGENTS.md
dashboard/screenshots/
dashboard/test-*.py

# Public community agent templates may intentionally include their own docs,
# AGENTS.md, memory skill, and scaffold files.
!community/agents/research-agent/
!community/agents/research-agent/**
